      "page": "/hackathons/[id]",
      "regex": "^/hackathons/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/hackathons/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/organizations/[login]",
      "regex": "^/organizations/([^/]+?)(?:/)?$",
